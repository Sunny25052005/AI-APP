generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Data {
  id       Int    @id @default(autoincrement())
  entity   String
  content  String  // JSON string
  userId   Int
}
